// =====================================================================
// DBML (Database Markup Language) Schema - OLTP Logistics System
// Compatible with dbdiagram.io / dbdocs.io
// =====================================================================

Table customer {
  customer_id varchar(32) [primary key]
  customer_name varchar(150) [not null]
  customer_type varchar(10) [not null, note: 'B2B or B2C']
  phone_number varchar(20) [not null]
  email varchar(100)
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_deleted boolean [default: false]
}

Table location {
  location_id varchar(32) [primary key]
  city_name varchar(100) [not null]
  province_name varchar(100) [not null]
  postal_code varchar(10) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_deleted boolean [default: false]
}

Table service_type {
  service_type_id varchar(32) [primary key]
  service_name varchar(50) [not null, note: 'Reguler, Express, SameDay']
  sla_days integer [not null]
  base_rate numeric(12,2) [not null, note: 'Tarif dasar per KG']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_deleted boolean [default: false]
}

Table hub {
  hub_id varchar(32) [primary key]
  hub_name varchar(100) [not null]
  location_id varchar(32) [not null]
  capacity_per_day integer [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_deleted boolean [default: false]
}

Table courier {
  courier_id varchar(32) [primary key]
  courier_name varchar(150) [not null]
  vehicle_type varchar(30) [not null, note: 'Motorcycle, Van, Truck']
  hub_id varchar(32) [not null]
  phone_number varchar(20) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_deleted boolean [default: false]
}

Table shipment {
  receipt_number varchar(50) [primary key]
  sender_customer_id varchar(32) [not null]
  recipient_name varchar(150) [not null]
  recipient_phone varchar(20) [not null]
  recipient_address text [not null]
  origin_location_id varchar(32) [not null]
  destination_location_id varchar(32) [not null]
  service_type_id varchar(32) [not null]
  package_weight_kg numeric(8,2) [not null]
  shipping_fee numeric(12,2) [not null]
  estimated_cost numeric(12,2) [not null]
  booking_timestamp timestamp [not null]
  estimated_delivery_date timestamp [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_deleted boolean [default: false]
}

Table shipment_status_log {
  status_log_id bigint [primary key, increment]
  receipt_number varchar(50) [not null]
  hub_id varchar(32)
  courier_id varchar(32)
  status_code varchar(30) [not null, note: 'PICKUP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, FAILED, RETURNED']
  failure_reason varchar(100) [note: 'Alamat Salah, Penerima Tidak di Rumah, dll']
  log_timestamp timestamp [default: `now()`]
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_deleted boolean [default: false]
}

Table claim {
  claim_id varchar(32) [primary key]
  receipt_number varchar(50) [not null, unique]
  claim_date timestamp [not null]
  claim_type varchar(20) [not null, note: 'LOST or DAMAGED']
  claim_amount numeric(12,2) [not null]
  claim_status varchar(20) [not null, note: 'SUBMITTED, INVESTIGATING, APPROVED, REJECTED']
  resolution_notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  is_deleted boolean [default: false]
}

// =====================================================================
// Relationships (Foreign Keys)
// =====================================================================

Ref: hub.location_id > location.location_id
Ref: courier.hub_id > hub.hub_id
Ref: shipment.sender_customer_id > customer.customer_id
Ref: shipment.origin_location_id > location.location_id
Ref: shipment.destination_location_id > location.location_id
Ref: shipment.service_type_id > service_type.service_type_id
Ref: shipment_status_log.receipt_number > shipment.receipt_number
Ref: shipment_status_log.hub_id > hub.hub_id
Ref: shipment_status_log.courier_id > courier.courier_id
Ref: claim.receipt_number - shipment.receipt_number

