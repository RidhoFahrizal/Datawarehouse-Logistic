  <transform>
    <type>Formula</type>
    <name>Calculate Date SKs</name>
    <formulas>
      <formula>
        <field_name>booking_date_sk</field_name>
        <formula>YEAR([booking_timestamp])*10000 + MONTH([booking_timestamp])*100 + DAY([booking_timestamp])</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>estimated_delivery_date_sk</field_name>
        <formula>YEAR([estimated_delivery_date])*10000 + MONTH([estimated_delivery_date])*100 + DAY([estimated_delivery_date])</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>actual_delivery_date_sk</field_name>
        <formula>IF(ISBLANK([actual_delivery_date]), 0, YEAR([actual_delivery_date])*10000 + MONTH([actual_delivery_date])*100 + DAY([actual_delivery_date]))</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
