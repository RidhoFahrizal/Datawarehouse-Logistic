<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>10_load_fact_shipment_event</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/11/13 03:10:00.735</created_date>
    <modified_date>2026/11/13 03:24:44.419</modified_date>
    <created_hop_version/>
    <modified_hop_version>2.20.0</modified_hop_version>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read OLTP Status Log</name>
    <sql>SELECT 
    status_log_id,
    receipt_number,
    hub_id,
    courier_id,
    status_code,
    failure_reason,
    log_timestamp,
    log_timestamp::time AS log_time
FROM oltp.shipment_status_log
WHERE is_deleted = FALSE;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN_POSTGRES_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Formula</type>
    <name>Calculate Log Date SK</name>
    <formulas>
      <formula>
        <field_name>log_date_sk</field_name>
        <formula>YEAR([log_timestamp])*10000 + MONTH([log_timestamp])*100 + DAY([log_timestamp])</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>336</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup Hub SK</name>
    <connection>CONN_POSTGRES_DWH</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>dwh</schema>
      <table>dim_hub</table>
      <key>
        <name>hub_id</name>
        <name2/>
        <condition>=</condition>
        <field>hub_id</field>
      </key>
      <value>
        <name>hub_sk</name>
        <rename>hub_sk</rename>
        <default>-1</default>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>512</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup Courier SK</name>
    <connection>CONN_POSTGRES_DWH</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>dwh</schema>
      <table>dim_courier</table>
      <key>
        <name>courier_id</name>
        <name2/>
        <condition>=</condition>
        <field>courier_id</field>
      </key>
      <value>
        <name>courier_sk</name>
        <rename>courier_sk</rename>
        <default>-1</default>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>656</xloc>
      <yloc>128</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup Status SK</name>
    <connection>CONN_POSTGRES_DWH</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>dwh</schema>
      <table>dim_status</table>
      <key>
        <name>status_code</name>
        <name2/>
        <condition>=</condition>
        <field>status_code</field>
      </key>
      <value>
        <name>status_sk</name>
        <rename>status_sk</rename>
        <default>0</default>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>656</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Formula</type>
    <name>Derive Event Indicators</name>
    <formulas>
      <formula>
        <field_name>event_count</field_name>
        <formula>1</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>is_final_success</field_name>
        <formula>IF([status_code]="DELIVERED", 1, 0)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>is_final_fail</field_name>
        <formula>IF([status_code]="FAILED", 1, 0)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>496</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Load Fact Shipment Event</name>
    <connection>CONN_POSTGRES_DWH</connection>
    <schema>dwh</schema>
    <table>fact_shipment_event</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>receipt_number</stream_name>
        <column_name>receipt_number</column_name>
      </field>
      <field>
        <stream_name>log_date_sk</stream_name>
        <column_name>log_date_sk</column_name>
      </field>
      <field>
        <stream_name>log_time</stream_name>
        <column_name>log_time</column_name>
      </field>
      <field>
        <stream_name>hub_sk</stream_name>
        <column_name>hub_sk</column_name>
      </field>
      <field>
        <stream_name>courier_sk</stream_name>
        <column_name>courier_sk</column_name>
      </field>
      <field>
        <stream_name>status_sk</stream_name>
        <column_name>status_sk</column_name>
      </field>
      <field>
        <stream_name>event_count</stream_name>
        <column_name>event_count</column_name>
      </field>
      <field>
        <stream_name>is_final_success</stream_name>
        <column_name>is_final_success</column_name>
      </field>
      <field>
        <stream_name>is_final_fail</stream_name>
        <column_name>is_final_fail</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read OLTP Status Log</from>
      <to>Calculate Log Date SK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calculate Log Date SK</from>
      <to>Lookup Hub SK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Hub SK</from>
      <to>Lookup Courier SK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Courier SK</from>
      <to>Lookup Status SK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Status SK</from>
      <to>Derive Event Indicators</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Derive Event Indicators</from>
      <to>Load Fact Shipment Event</to>
      <enabled>Y</enabled>
