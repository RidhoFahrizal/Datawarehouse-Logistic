  <transform>
    <type>TableInput</type>
    <name>Read OLTP Claim</name>
    <sql>SELECT 
    c.claim_id,
    c.receipt_number,
    c.claim_date,
    c.claim_type,
    c.claim_amount,
    c.claim_status,
    s.sender_customer_id AS customer_id
FROM oltp.claim c
JOIN oltp.shipment s ON c.receipt_number = s.receipt_number
WHERE c.is_deleted = FALSE;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>ProjectETL</connection>
    <lookup/>
    <sql_from_file/>
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>256</xloc>
      <yloc>304</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Formula</type>
    <name>Derive Claim Date SK</name>
    <formulas>
      <formula>
        <field_name>claim_date_sk</field_name>
        <formula>YEAR([claim_date]) * 10000 + MONTH([claim_date]) * 100 + DAY([claim_date])</formula>
        <value_type>5</value_type>
        <value_length>8</value_length>
        <value_precision>0</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>304</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Database lookup</name>
    <connection>DWH</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>dwh</schema>
      <table>dim_customer</table>
      <key>
        <name>claim_id</name>
        <name2/>
        <condition>=</condition>
        <field>customer_id</field>
      </key>
      <value>
        <name>customer_sk</name>
        <rename>customer_sk</rename>
        <default>-1</default>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>832</xloc>
      <yloc>304</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup Dim Status SK</name>
    <connection>DWH</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>dwh</schema>
      <table>dim_status</table>
      <key>
        <name>claim_status</name>
        <name2/>
        <condition>=</condition>
        <field>status_code</field>
      </key>
      <value>
        <name>status_sk</name>
        <rename>status_sk</rename>
        <default>0</default>
        <type>integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>832</xloc>
      <yloc>464</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Formula</type>
    <name>Derive Metrics and Flags</name>
    <formulas>
      <formula>
        <field_name>claim_count</field_name>
        <formula>1</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>is_approved</field_name>
        <formula>IF([claim_status]="APPROVED",1, 0)</formula>
        <value_type>5</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>624</xloc>
      <yloc>464</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Select Fact Fields</name>
    <fields>
      <field>
        <name>claim_id</name>
        <rename/>
        <length>-2</length>
        <precision>-2</precision>
      </field>
      <field>
        <name>receipt_number</name>
        <rename/>
        <length>-2</length>
