  <transform>
    <type>TableInput</type>
    <name>Read OLTP Courier With Hub Location</name>
    <sql>SELECT 
    c.courier_id,
    c.courier_name,
    c.vehicle_type,
    l.city_name AS base_city_name,
    l.province_name AS base_province_name,
    c.hub_id,
    '2026-01-01 00:00:00'::timestamp AS effective_date,
    '9999-12-31 23:59:59'::timestamp AS expiration_date,
    TRUE AS is_current
FROM oltp.courier c
JOIN oltp.hub h ON c.hub_id = h.hub_id
JOIN oltp.location l ON h.location_id = l.location_id
WHERE c.is_deleted = FALSE;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN_POSTGRES_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>208</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
