  <transform>
    <type>TableInput</type>
    <name>Read Distinct Status Log &amp; Claim</name>
    <sql>SELECT 
    0 AS status_sk, 
    'UNKNOWN' AS status_code, 
    'UNKNOWN' AS status_group, 
    'Unknown' AS failure_reason, 
    FALSE AS is_terminal_status
UNION ALL
SELECT 
    NULL AS status_sk,
    s.status_code,
    CASE 
        WHEN s.status_code IN ('DELIVERED', 'APPROVED') THEN 'SUCCESS'
        WHEN s.status_code IN ('FAILED', 'REJECTED') THEN 'FAILED'
        WHEN s.status_code = 'RETURNED' THEN 'RETURNED'
        ELSE 'IN_PROGRESS'
    END AS status_group,
    NULL AS failure_reason,
    CASE 
        WHEN s.status_code IN ('DELIVERED', 'RETURNED', 'APPROVED', 'REJECTED') THEN TRUE
        ELSE FALSE
    END AS is_terminal_status
FROM (
    SELECT DISTINCT status_code FROM oltp.shipment_status_log
    UNION
    SELECT DISTINCT claim_status AS status_code FROM oltp.claim
) s;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN_POSTGRES_OLTP</connection>
    <lookup/>
    <sql_from_file/>
