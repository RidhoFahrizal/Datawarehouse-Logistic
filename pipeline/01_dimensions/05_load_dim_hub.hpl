  <transform>
    <type>TableInput</type>
    <name>Read OLTP Hub With Location</name>
    <sql>SELECT h.hub_id, h.hub_name, l.city_name, l.province_name, h.capacity_per_day 
FROM oltp.hub h 
JOIN oltp.location l ON h.location_id = l.location_id 
WHERE h.is_deleted = FALSE;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN_POSTGRES_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
