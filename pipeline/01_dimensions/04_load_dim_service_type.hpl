    <name>Read OLTP Service Type</name>
    <sql>SELECT 
    'UNKNOWN' AS service_type_id, 
    'Unknown Service' AS service_name, 
    0 AS sla_days, 
    0.0 AS base_rate, 
    '1970-01-01 00:00:00'::timestamp AS effective_date, 
    '9999-12-31 23:59:59'::timestamp AS expiration_date, 
    TRUE AS is_current
UNION ALL
SELECT 
    service_type_id, 
    service_name, 
    sla_days, 
    base_rate, 
    '2026-01-01 00:00:00'::timestamp AS effective_date, 
    '9999-12-31 23:59:59'::timestamp AS expiration_date, 
    TRUE AS is_current
FROM oltp.service_type
WHERE is_deleted = FALSE;</sql>
