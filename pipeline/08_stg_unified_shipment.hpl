  <transform>
    <type>TableInput</type>
    <name>Read OLTP Shipments</name>
    <sql>SELECT 
    s.receipt_number,
    s.sender_customer_id AS customer_id,      
    s.origin_location_id,
    s.destination_location_id,
    s.service_type_id,
    s.package_weight_kg,
    s.shipping_fee,
    s.estimated_cost,
    s.booking_timestamp,
    s.estimated_delivery_date,
    l.log_timestamp AS actual_delivery_date,  
    l.status_code   AS final_status_code,     
    l.failure_reason                          
FROM oltp.shipment s
LEFT JOIN (
    SELECT DISTINCT ON (receipt_number) 
        receipt_number, 
        status_code, 
        failure_reason, 
        log_timestamp
    FROM oltp.shipment_status_log
    ORDER BY receipt_number, log_timestamp DESC
) l ON s.receipt_number = l.receipt_number
WHERE s.is_deleted = FALSE;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>CONN_POSTGRES_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
